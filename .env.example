# PostgreSQL 16 database connection string
DATABASE_URL="postgresql://user@127.0.0.1:5432/rprm?schema=public"

# 32+ byte secret used to HMAC-sign session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=""

# 32+ byte secret used for AES-256-GCM encryption of partner bank details at rest (generate with: openssl rand -hex 32)
BANK_ENCRYPTION_KEY=""

# 16+ byte bearer token required by POST /api/scheduler for headless cron ticks
CRON_SECRET=""

# Base application origin (required in production; defaults to http://127.0.0.1:3000 in development)
APP_BASE_URL="http://127.0.0.1:3000"

# One-time setup token required in production (NODE_ENV=production) to submit the first-run /setup form
SETUP_TOKEN=""

# Password for demo coworker accounts when running npm run demo:seed (refused in production)
SEED_ADMIN_PASSWORD=""

# Password for demo partner accounts when running npm run demo:seed (refused in production)
SEED_PARTNER_PASSWORD=""

# Show local development login hints on /login and /p/login when NODE_ENV !== 'production'
SHOW_DEV_LOGINS="false"

# Outbound email driver: "local" (in-app outbox) or "smtp" (real SMTP delivery via nodemailer)
EMAIL_DRIVER="local"

# Sender address used for outbound emails
EMAIL_FROM="noreply@r-prm.local"

# SMTP server hostname when EMAIL_DRIVER="smtp"
SMTP_HOST="127.0.0.1"

# SMTP server port when EMAIL_DRIVER="smtp"
SMTP_PORT="587"

# Optional SMTP username for authenticated SMTP relays
SMTP_USER=""

# Optional SMTP password for authenticated SMTP relays
SMTP_PASS=""

# File storage driver: "disk" (private storage/uploads/ folder); "s3" fails closed until implemented
STORAGE_DRIVER="disk"

# S3 endpoint URL (reserved for future S3 storage driver)
S3_ENDPOINT=""

# S3 bucket name (reserved for future S3 storage driver)
S3_BUCKET=""

# S3 access key ID (reserved for future S3 storage driver)
S3_ACCESS_KEY_ID=""

# S3 secret access key (reserved for future S3 storage driver)
S3_SECRET_ACCESS_KEY=""

# Payout settlement driver: "manual" (working); "wise" or "stripe" fail closed until implemented
PAYOUT_DRIVER="manual"

# API key for external payout provider (reserved for future payout driver)
PAYOUT_API_KEY=""

# HubSpot CRM driver: "mock" (local); "live" fails closed until implemented
HUBSPOT_DRIVER="mock"

# HubSpot private app token (reserved for future live HubSpot driver)
HUBSPOT_PRIVATE_APP_TOKEN=""

# Exchange-rate driver: "table" (dated rate table); "api" fails closed until implemented
FX_DRIVER="table"

# Exchange-rate API key (reserved for future live FX API driver)
FX_API_KEY=""

# Single Sign-On driver: "local" (password + TOTP MFA); "saml" fails closed until implemented
SSO_DRIVER="local"

# SAML 2.0 Identity Provider login URL (reserved for future SAML driver)
SAML_IDP_LOGIN_URL=""

# SAML 2.0 Identity Provider X.509 certificate (reserved for future SAML driver)
SAML_IDP_CERT=""
